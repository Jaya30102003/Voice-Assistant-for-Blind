@{
    ViewData["Title"] = "Job Statistics";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="icon" type="image/png" href="~/Assets/Logo.png" />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 20px;
        }
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="color: #004F90;">📊 Job Statistics Dashboard</h2>
            <a href="/JobAdmin" style="padding: 10px 20px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px;">← Back to Jobs</a>
        </div>
        
        <!-- Summary Cards -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px;">
            <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h3 style="margin: 0 0 10px 0; font-size: 16px; opacity: 0.9;">Total Jobs</h3>
                <p style="margin: 0; font-size: 36px; font-weight: bold;">@(ViewBag.TotalJobs ?? 0)</p>
                <p style="margin: 5px 0 0 0; font-size: 14px; opacity: 0.8;">All time</p>
            </div>
            
            <div class="stat-card" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <h3 style="margin: 0 0 10px 0; font-size: 16px; opacity: 0.9;">Active Jobs</h3>
                <p style="margin: 0; font-size: 36px; font-weight: bold;">@(ViewBag.ActiveJobs ?? 0)</p>
                <p style="margin: 5px 0 0 0; font-size: 14px; opacity: 0.8;">Currently accepting</p>
            </div>
            
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <h3 style="margin: 0 0 10px 0; font-size: 16px; opacity: 0.9;">Expired/Inactive</h3>
                <p style="margin: 0; font-size: 36px; font-weight: bold;">@(ViewBag.ExpiredJobs ?? 0)</p>
                <p style="margin: 5px 0 0 0; font-size: 14px; opacity: 0.8;">Past deadline</p>
            </div>
        </div>
        
        <!-- Jobs by Company -->
        <div style="background: white; padding: 25px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 30px;">
            <h3 style="margin-top: 0; color: #333;">🏢 Jobs by Company</h3>
            @if (ViewBag.JobsByCompany != null && ((IEnumerable<dynamic>)ViewBag.JobsByCompany).Any())
            {
                <div style="margin-top: 20px;">
                    @foreach (var item in ViewBag.JobsByCompany)
                    {
                        var percentage = ViewBag.TotalJobs > 0 ? (item.Count * 100 / ViewBag.TotalJobs) : 0;
                        <div style="margin-bottom: 15px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                <span style="font-weight: 500;">@item.Company</span>
                                <span style="color: #666;">@item.Count job(s)</span>
                            </div>
                            <div style="background: #f0f0f0; height: 10px; border-radius: 5px; overflow: hidden;">
                                <div style="background: #004F90; width: @percentage%; height: 100%;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 40px; background: #f8f9fa; border-radius: 8px;">
                    <p style="color: #666; margin: 0;">No company data available</p>
                </div>
            }
        </div>
        
        <!-- Quick Actions -->
        <div style="background: #f8f9fa; padding: 25px; border-radius: 10px;">
            <h3 style="margin-top: 0; color: #333;">🚀 Quick Actions</h3>
            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
                <a href="/JobAdmin/Create" style="padding: 12px 25px; background: #004F90; color: white; text-decoration: none; border-radius: 4px;">➕ Create Job</a>
                <a href="/JobAdmin/ActiveJobs" style="padding: 12px 25px; background: #28a745; color: white; text-decoration: none; border-radius: 4px;">✅ Active Jobs</a>
                <a href="/JobAdmin/ExpiredJobs" style="padding: 12px 25px; background: #dc3545; color: white; text-decoration: none; border-radius: 4px;">⚠️ Expired Jobs</a>
            </div>
        </div>
    </div>
</body>
</html>